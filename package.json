{
  "name": "cellular-automata-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive cellular automata modeling, simulation and experimentation environment for a Modelling and Simulation course.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run schemas && vite build",
    "preview": "vite preview",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "schemas": "node scripts/compile-schemas.mjs",
    "pretest": "npm run schemas",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "node scripts/bench.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "ajv": "8.20.0",
    "clsx": "2.1.1",
    "dexie": "4.4.7",
    "lucide-react": "0.546.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "19.2.4",
    "recharts": "3.10.1",
    "seedrandom": "3.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "22.19.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/seedrandom": "3.0.8",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.2.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.1",
    "vitest": "3.2.7"
  }
}
